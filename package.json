{
  "name": "vite-express-rsc-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "tests/fixture"
  ],
  "scripts": {
    "dev": "npm run dev -w examples/basic",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "build:packages": "npm run build -w packages/vite-express-rsc && npm run build -w packages/oapi",
    "predev": "npm run build:packages",
    "prebuild": "npm run build:packages",
    "pretest": "npm run build:packages",
    "pretypecheck": "npm run build:packages",
    "prepack:packages": "node --input-type=module -e \"import { rmSync, mkdirSync } from 'node:fs'; rmSync('.release', { recursive: true, force: true }); mkdirSync('.release')\"",
    "pack:packages": "npm pack --workspace packages/oapi --workspace packages/vite-express-rsc --ignore-scripts --pack-destination .release"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "version": "0.1.0"
}
