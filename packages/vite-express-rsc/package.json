{
  "name": "@opentyped/vite-express-rsc",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./context": {
      "types": "./dist/runtime/context.d.ts",
      "import": "./dist/runtime/context.js"
    },
    "./app": {
      "types": "./dist/runtime/app.d.ts",
      "import": "./dist/runtime/app.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "bin": {
    "express-rsc": "./dist/dev.js"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@remix-run/node-fetch-server": "0.13.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-rsc": "0.5.38",
    "openapi-types": "^12.1.3",
    "react-server-dom-webpack": "19.2.8"
  },
  "peerDependencies": {
    "express": "^5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.5.0",
    "vite": "^8.3.5"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opentyped/vite-express-rsc.git",
    "directory": "packages/vite-express-rsc"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
