{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false,
    "allowJs": false,
    "noEmitOnError": true,
    "paths": {
      "@opentyped/vite-express-rsc": ["./src/plugin.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["dist"]
}
