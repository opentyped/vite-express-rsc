{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "@vitejs/plugin-rsc/types"]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "vite.config.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "eslint.config.ts"
  ],
  "exclude": ["**/dist", "**/node_modules"]
}
